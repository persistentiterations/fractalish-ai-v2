{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionGlyph",
  "type": "object",
  "required": ["activation_id", "purpose", "state_hash"],
  "properties": {
    "activation_id": { "type": "string" },
    "purpose": { "type": "string" },
    "operator_constraints": { "type": "array", "items": { "type": "string" } },
    "open_loops": { "type": "array" },
    "unresolved_holds": { "type": "array" },
    "contradiction_scars": { "type": "array" },
    "recovery_routes": { "type": "array" },
    "key_sources": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "state_hash": { "type": "string" }
  }
}