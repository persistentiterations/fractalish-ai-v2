{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReceptorEvent",
  "type": "object",
  "required": [
    "receptor_id", "receptor_type", "event_id", "timestamp", "source",
    "modality", "raw_reference", "raw_summary", "local_only"
  ],
  "properties": {
    "receptor_id": { "type": "string" },
    "receptor_type": {
      "enum": [
        "human_note", "file_drop", "maze_trace", "natural_math_run",
        "morphology_trace", "sensor_stub", "multimodal_stub", "infinitysight_token"
      ]
    },
    "event_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "source": { "type": "string" },
    "modality": { "type": "string" },
    "raw_reference": { "type": "string" },
    "raw_summary": { "type": "string" },
    "normalized_payload": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
    "noise_estimate": { "type": "number" },
    "provenance": { "type": "object" },
    "domain_tags": { "type": "array", "items": { "type": "string" } },
    "privacy_scope": { "type": "string" },
    "local_only": { "type": "boolean" },
    "suggested_basin_tags": { "type": "array", "items": { "type": "string" } },
    "possible_claims": { "type": "array", "items": { "type": "string" } },
    "missing_context": { "type": "array", "items": { "type": "string" } },
    "receptor_notes": { "type": "string" }
  }
}